# Admin password for backend login
ADMIN_PASSWORD=your_password_here

# Session secret (auto-generated if not set)
SESSION_SECRET=your_random_session_secret_here

# Firebase Config (จาก Firebase Console > Project Settings > Your apps)
FIREBASE_API_KEY=your_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# EasySlip API (v2) - ตรวจสอบสลิปโอนเงินอัตโนมัติ
# สมัครและรับ API Key ได้ที่ https://developer.easyslip.com
EASYSLIP_API_KEY=your_easyslip_api_key_here
