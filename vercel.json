{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "helloxglitter-preorder.vercel.app" }],
      "destination": "https://helloxglitterstore.vercel.app/$1",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/designer", "destination": "/From_Designer/designer.html" },
    { "source": "/admin", "destination": "/api/admin-logout" },
    { "source": "/admin/:match*", "destination": "/api/admin-logout" }
  ]
}
